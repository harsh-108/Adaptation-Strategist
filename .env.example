# Copy to .env and fill in. .env is ignored by git and by gcloud deploys.
# Values already set in your shell take priority over this file.

# Gemini (Google AI Studio key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest

# Or use Vertex AI instead of an API key
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional Groq backup (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b

# AI_TIMEOUT_MS=20000
# MOCK_AI=1
# PORT=8080

# --- Energy and air-quality data (server-side only, never sent to the browser) ---
# Electricity Maps: https://app.electricitymaps.com  (header auth-token)
ELECTRICITYMAPS_API_KEY=
# Ember: https://ember-energy.org/data/api
EMBER_API_KEY=
# EIA (US only): https://www.eia.gov/opendata/  (DEMO_KEY works for light testing)
EIA_API_KEY=
# Google Maps Platform key with the Weather, Air Quality and Geocoding APIs enabled. Live readings, alert limits and the
# hub search use Google first and fall back to Open-Meteo when this is empty or Google has no answer.
GOOGLE_MAPS_API_KEY=

# Impact page "Export to Google Sheets" and "Create brief in Google Docs": an OAuth 2.0 Client ID of type Web application
# (Google Cloud console > APIs & Services > Credentials). Add http://localhost:8080 and your Cloud Run URL as Authorized
# JavaScript origins, and enable the Google Sheets API and Google Docs API. Not a secret.
GOOGLE_OAUTH_CLIENT_ID=

# Earth view · Data centres on Google Maps: a Maps JavaScript API key for the browser. It is sent to visitors, so restrict
# it to your site's address (HTTP referrers) and to the Maps JavaScript API. Empty = the Leaflet + OpenStreetMap map.
GOOGLE_MAPS_BROWSER_KEY=

# OpenAQ: https://explore.openaq.org/register  (header X-API-Key)
OPENAQ_API_KEY=
# WattTime: not used by the app at present (no code reads these two settings); kept for a possible future carbon signal.
# https://docs.watttime.org  (username/password exchanged for a token)
WATTTIME_USERNAME=
WATTTIME_PASSWORD=

# No login: the whole team shares one workspace. Keep the server on an internal network or VPN.

# Optional, not used for the current data: Earth Engine and BigQuery data jobs (python -m jobs.check_gcp) use
# GOOGLE_CLOUD_PROJECT above plus a service-account key.
# Keep the key file outside the folder you deploy.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ---- Firebase, Firestore and Google Analytics (Google Cloud deploy) ----
# Google Analytics 4 measurement ID from the Firebase project (Project settings > General > Your apps > Web app),
# looks like G-ABC123XYZ. Public by design; the page loads the tag only after the visitor presses "Allow analytics".
GA_MEASUREMENT_ID=
# Set by deploy\gcp\deploy.ps1 on Cloud Run; leave unset locally (SQLite is used, and hub edits stay open).
# FIRESTORE=on
# DEMO_LOCK_HUBS=1
# ALLOWED_ORIGINS=https://YOUR_PROJECT.web.app,https://YOUR_PROJECT.firebaseapp.com
